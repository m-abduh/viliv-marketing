// Prisma schema for viliv-marketing — CATALOG (read-only)
// Reads the shared viliv Postgres database. Data managed by the viliv project.
// NEVER write to these models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id           String   @id @default(cuid())
  name         String
  slug         Int      @unique
  imageUrl     String
  affiliateUrl String
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}