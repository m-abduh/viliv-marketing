OPENROUTER_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
TZ=America/New_York
PORT=5002
PUBLIC_URL=http://localhost:5002
RENDER_CONCURRENCY=1
DISABLE_SCHEDULER=1

# Prisma Postgres — shared viliv catalog DB (READ-ONLY, managed by the viliv project)
DATABASE_URL="postgres://user:password@host:5432/database?sslmode=require"

# Local SQLite DB for this project's own data (settings, accounts, posts)
# Path is relative to the prisma/ directory.
DATABASE_URL_LOCAL="file:./marketing.db"

# DATABASE_URL non-pooled variant (di Prisma Postgres biasanya format tcp://...)
# DATABASE_URL_UNPOOLED="postgres://user:password@tcp.db.prisma.io:5432/database"